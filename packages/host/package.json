{
  "name": "@dsh-layerfs/host",
  "version": "0.1.0",
  "description": "Host half of LayerFS × DSH: project bindings, the bash environment, trace collection into session records, and the /layerfs route",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-alpha.4 <0.3.0"
  },
  "dependencies": {
    "@dsh-layerfs/model": "workspace:*",
    "@layerfs/agent": "./src/layerfs-v2-shim/agent.js",
    "@layerfs/backend": "./src/layerfs-v2-shim/backend.js",
    "@layerfs/runtime": "./src/layerfs-v2-shim/runtime.js",
    "@layerfs/node": "link:../../.layerfs/api/node"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
