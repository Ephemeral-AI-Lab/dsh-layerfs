{
 "type": "layerfs-scenario",
 "version": 3,
 "title": "Tour",
 "blurb": "One agent at the terminals: fs writes, a Sandbox terminal that installs, builds and serves, a stale Workspace that merges on commit, a second Workspace in the same Sandbox, and two publishes, the second overwriting the first.",
 "order": 1,
 "layerfs": [
  "mocked",
  "real"
 ],
 "fixture": "../../demo-workspace",
 "lib": "../shared/terminal.mjs",
 "agents": {
  "root": [
   {
    "bash": {
     "description": "fork feature-home",
     "run": [
      [
       "history",
       "fork feature-home"
      ]
     ]
    },
    "phase": "Fork",
    "expect": [
     "branch.fork:Forked"
    ]
   },
   {
    "bash": {
     "description": "fs on feature-home: edit app/page.tsx \"Hello world\" \"Welcome to Layer…",
     "run": [
      [
       "fs",
       "feature-home",
       "edit",
       "app/page.tsx",
       "Hello world",
       "Welcome to LayerFS"
      ]
     ]
    },
    "phase": "Write with fs",
    "expect": [
     "fs.edit:Committed"
    ]
   },
   {
    "bash": {
     "description": "fs on feature-home: mkdir app/about",
     "run": [
      [
       "fs",
       "feature-home",
       "mkdir",
       "app/about"
      ],
      [
       "fs",
       "feature-home",
       "write",
       "app/about/page.tsx",
       "export default function Page() {\n  return <main><h1>We're building with LayerFS</h1></main>;\n}\n"
      ]
     ]
    },
    "expect": [
     "fs.mkdir:Committed",
     "fs.write:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: open a Sandbox terminal on feature-home",
     "run": [
      [
       "sandbox",
       "feature-home"
      ],
      [
       "open",
       "sb1",
       "feature-home",
       "feature-home"
      ]
     ]
    },
    "phase": "Build",
    "expect": [
     "sandbox.create:Ready",
     "sandbox.mount:Mounted"
    ]
   },
   {
    "bash": {
     "description": "sb1: sh install.sh",
     "run": [
      [
       "term",
       "sb1",
       "sh install.sh"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: sh build.sh",
     "run": [
      [
       "term",
       "sb1",
       "sh build.sh"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:1"
    ]
   },
   {
    "bash": {
     "description": "sb1: sed -i \"s/We're/We\\&apos;re/\" app/about/page.tsx",
     "run": [
      [
       "term",
       "sb1",
       "sed -i \"s/We're/We\\&apos;re/\" app/about/page.tsx"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: sh build.sh",
     "run": [
      [
       "term",
       "sb1",
       "sh build.sh"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: sh serve.sh &",
     "run": [
      [
       "term",
       "sb1",
       "sh serve.sh &"
      ]
     ]
    },
    "phase": "Serve",
    "expect": [
     "operator.process.start:running"
    ]
   },
   {
    "bash": {
     "description": "sb1: unmount",
     "run": [
      [
       "term",
       "sb1",
       "unmount"
      ]
     ]
    },
    "expect": [
     "sandbox.unmount:Busy"
    ]
   },
   {
    "bash": {
     "description": "sb1: stop",
     "run": [
      [
       "term",
       "sb1",
       "stop"
      ]
     ]
    },
    "expect": [
     "operator.process.cancel:Stopped"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "phase": "Commit",
    "expect": [
     "sandbox.commit:Committed"
    ]
   },
   {
    "bash": {
     "description": "fs on feature-home: write CHANGELOG.md \"- about page\"",
     "run": [
      [
       "fs",
       "feature-home",
       "write",
       "CHANGELOG.md",
       "- about page"
      ]
     ]
    },
    "phase": "Stale Workspace",
    "expect": [
     "fs.write:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: echo \"PORT=3000\" > .env.example",
     "run": [
      [
       "term",
       "sb1",
       "echo \"PORT=3000\" > .env.example"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "expect": [
     "sandbox.commit:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb2: split sb1",
     "run": [
      [
       "split",
       "sb1",
       "sb2"
      ]
     ]
    },
    "phase": "Split",
    "expect": [
     "sandbox.mount:Mounted"
    ]
   },
   {
    "bash": {
     "description": "sb2: echo \"Built with LayerFS\" >> README.md",
     "run": [
      [
       "term",
       "sb2",
       "echo \"Built with LayerFS\" >> README.md"
      ]
     ]
    },
    "expect": [
     "sandbox.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb2: commit",
     "run": [
      [
       "term",
       "sb2",
       "commit"
      ]
     ]
    },
    "expect": [
     "sandbox.commit:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: unmount",
     "run": [
      [
       "term",
       "sb1",
       "unmount"
      ]
     ]
    },
    "expect": [
     "sandbox.unmount:Unmounted"
    ]
   },
   {
    "bash": {
     "description": "sb2: unmount",
     "run": [
      [
       "term",
       "sb2",
       "unmount"
      ],
      [
       "closeAll"
      ]
     ]
    },
    "expect": [
     "sandbox.unmount:Unmounted",
     "sandbox.close:Closed"
    ]
   },
   {
    "bash": {
     "description": "fork header from C4",
     "run": [
      [
       "history",
       "fork header from C4"
      ]
     ]
    },
    "phase": "Second Branch",
    "expect": [
     "branch.fork:Forked"
    ]
   },
   {
    "bash": {
     "description": "fs on header: write app/header.tsx \"export const Header = () => <head…",
     "run": [
      [
       "fs",
       "header",
       "write",
       "app/header.tsx",
       "export const Header = () => <header/>;"
      ]
     ]
    },
    "expect": [
     "fs.write:Committed"
    ]
   },
   {
    "bash": {
     "description": "publish feature-home",
     "run": [
      [
       "history",
       "publish feature-home"
      ]
     ]
    },
    "phase": "Publish",
    "expect": [
     "branch.publish:Added"
    ]
   },
   {
    "bash": {
     "description": "publish header",
     "run": [
      [
       "history",
       "publish header"
      ]
     ]
    },
    "expect": [
     "branch.publish:Added"
    ]
   },
   {
    "reply": "main has header's files only: publish overwrites, and feature-home's Layer stays in history. Merge first to keep both."
   }
  ]
 }
}
