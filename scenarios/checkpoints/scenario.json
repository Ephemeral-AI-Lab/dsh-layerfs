  "root": [
   {
    "phase": "Range 1",
    "say": "Four ranges, two agents each. Each range ends at a checkpoint.",
    "subagent": {
     "description": "a01",
     "prompt": "You are a01 of the checkpoints demo. Each turn writes your part of the range the lead names on a lane of your own; report when it is done."
    }
   },
   {
    "subagent": {
     "description": "a02",
     "prompt": "You are a02 of the checkpoints demo. Each turn writes your part of the range the lead names on a lane of your own; report when it is done."
    }
   },
   {
    "reply": "Waiting for a01 and a02 to finish range 1.",
    "until": [
     "a01",
     "a02"
    ]
   },
   {
    "say": "Both lanes of range 1 are done: merging and publishing.",
    "bash": {
     "description": "Range 1: merge the lanes and publish",
     "run": [
      [
       "consolidate",
       1
      ]
     ]
    },
    "expect": [
     "branch.merge:Merged",
     "branch.publish:Added"
    ]
   },
   {
    "say": "Checking main at the end of range 1.",
    "bash": {
     "description": "Range 1: verify the checkpoint",
     "run": [
      [
       "verify",
       1
      ]
     ]
    }
   },
