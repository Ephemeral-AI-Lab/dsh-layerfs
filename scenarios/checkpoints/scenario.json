{
 "type": "layerfs-scenario",
 "version": 3,
 "title": "Checkpoints",
 "blurb": "A small history replay in four ranges: two agents write on lanes of their own, and the lead merges, publishes and verifies each range. (#352; the gate numbers are fake.)",
 "order": 10,
 "layerfs": [
  "mocked",
  "real"
 ],
 "fixture": "../../demo-workspace",
