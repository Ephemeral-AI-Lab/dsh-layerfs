{
 "type": "layerfs-scenario",
 "version": 3,
 "title": "Commit & merge",
 "blurb": "A stale Workspace that merges cleanly on commit, a commit conflict fixed in the Workspace, a merge of two Branches into a new one, a merge conflict, and a publish.",
 "order": 4,
 "layerfs": [
  "mocked",
  "real"
 ],
 "fixture": "../../demo-workspace",
 "lib": "../shared/terminal.mjs",
 "agents": {
  "root": [
   {
    "bash": {
     "description": "fork feature",
     "run": [
      [
       "history",
       "fork feature"
      ]
     ]
    },
    "phase": "Fork",
    "expect": [
     "branch.fork:Forked"
    ]
   },
   {
    "bash": {
     "description": "sb1: open a Sandbox terminal on feature",
     "run": [
      [
       "sandbox",
       "feature"
      ],
      [
       "open",
       "sb1",
       "feature",
       "feature"
      ]
     ]
    },
    "phase": "Commit",
    "expect": [
     "sandbox.create:ok",
     "workspace.mount:Mounted"
    ]
   },
   {
    "bash": {
     "description": "sb1: sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx",
     "run": [
      [
       "term",
       "sb1",
       "sed -i \"s/Hello world/Hello from the Workspace/\" app/page.tsx"
      ]
     ]
    },
    "expect": [
     "workspace.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "fs on feature: edit README.md \"# Website\" \"# Website (feature)\"",
     "run": [
      [
       "fs",
       "feature",
       "edit",
       "README.md",
       "# Website",
       "# Website (feature)"
      ]
     ]
    },
    "expect": [
     "fs.edit:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "expect": [
     "workspace.commit:Committed"
    ]
   },
   {
    "bash": {
     "description": "fs on feature: edit app/page.tsx \"Hello from the Workspace\" \"Hello fr…",
     "run": [
      [
       "fs",
       "feature",
       "edit",
       "app/page.tsx",
       "Hello from the Workspace",
       "Hello from fs"
      ]
     ]
    },
    "phase": "Commit conflict",
    "expect": [
     "fs.edit:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: sed -i \"s/Hello from the Workspace/Hello, Workspace/\" app/page.t…",
     "run": [
      [
       "term",
       "sb1",
       "sed -i \"s/Hello from the Workspace/Hello, Workspace/\" app/page.tsx"
      ]
     ]
    },
    "expect": [
     "workspace.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "expect": [
     "workspace.commit:Conflict"
    ]
   },
   {
    "bash": {
     "description": "sb1: cat app/page.tsx",
     "run": [
      [
       "term",
       "sb1",
       "cat app/page.tsx"
      ]
     ]
    },
    "expect": [
     "workspace.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "expect": [
     "workspace.commit:Conflict"
    ]
   },
   {
    "bash": {
     "description": "sb1: sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page…",
     "run": [
      [
       "term",
       "sb1",
       "sed -i '/Hello from fs\\|^<<<<<<<\\|^=======\\|^>>>>>>>/d' app/page.tsx"
      ]
     ]
    },
    "expect": [
     "workspace.exec:exit:0"
    ]
   },
   {
    "bash": {
     "description": "sb1: commit",
     "run": [
      [
       "term",
       "sb1",
       "commit"
      ]
     ]
    },
    "expect": [
     "workspace.commit:Committed"
    ]
   },
   {
    "bash": {
     "description": "sb1: unmount",
     "run": [
      [
       "term",
       "sb1",
       "unmount"
      ],
      [
       "closeAll"
      ]
     ]
    },
    "expect": [
     "workspace.unmount:Unmounted",
     "sandbox.close:Closed"
    ]
   },
   {
    "bash": {
     "description": "fork header",
     "run": [
      [
       "history",
       "fork header"
      ]
     ]
    },
    "phase": "Merge",
    "expect": [
     "branch.fork:Forked"
    ]
   },
   {
    "bash": {
     "description": "fs on header: write app/header.tsx \"export const Header = () => <head…",
     "run": [
      [
       "fs",
       "header",
       "write",
       "app/header.tsx",
       "export const Header = () => <header/>;"
      ]
     ]
    },
    "expect": [
     "fs.write:Committed"
    ]
   },
   {
    "bash": {
     "description": "merge feature header as release",
     "run": [
      [
       "history",
       "merge feature header as release"
      ]
     ]
    },
    "expect": [
     "branch.merge:Merged"
    ]
   },
   {
    "bash": {
     "description": "fs on header: edit app/page.tsx \"Hello world\" \"Hello from header\"",
     "run": [
      [
       "fs",
       "header",
       "edit",
       "app/page.tsx",
       "Hello world",
       "Hello from header"
      ]
     ]
    },
    "phase": "Merge conflict",
    "expect": [
     "fs.edit:Committed"
    ]
   },
   {
    "bash": {
     "description": "merge release header as release-2",
     "run": [
      [
       "history",
       "merge release header as release-2"
      ]
     ]
    },
    "expect": [
     "branch.merge:Conflict"
    ]
   },
   {
    "bash": {
     "description": "fs on header: edit app/page.tsx \"Hello from header\" \"Hello, Workspace\"",
     "run": [
      [
       "fs",
       "header",
       "edit",
       "app/page.tsx",
       "Hello from header",
       "Hello, Workspace"
      ]
     ]
    },
    "expect": [
     "fs.edit:Committed"
    ]
   },
   {
    "bash": {
     "description": "merge release header as release-2",
     "run": [
      [
       "history",
       "merge release header as release-2"
      ]
     ]
    },
    "expect": [
     "branch.merge:Merged"
    ]
   },
   {
    "bash": {
     "description": "publish release-2",
     "run": [
      [
       "history",
       "publish release-2"
      ]
     ]
    },
    "phase": "Publish",
    "expect": [
     "branch.publish:Added"
    ]
   },
   {
    "reply": "main has feature's and header's work."
   }
  ]
 }
}
